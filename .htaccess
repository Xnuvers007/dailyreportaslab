# Disable directory indexing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

# Block direct HTTP access to private directories & sensitive deployment files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(uploads|storage|config|includes)(/.*)?$ - [F,L,NC]
    RewriteRule ^(Dockerfile|docker-compose\.yml|router\.php|\.dockerignore|\.gitignore|\.env.*)$ - [F,L,NC]
</IfModule>

# Protect sensitive files & databases
<FilesMatch "(?i)^(Dockerfile|docker-compose\.yml|router\.php|\.dockerignore|\.gitignore|\.env.*)$|\.(sql|sqlite|db|env|ini|log|sh|bak|swp|md|json|lock|git.*|yml|yaml|example|config)$">
    Order Deny,Allow
    Deny from all
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

