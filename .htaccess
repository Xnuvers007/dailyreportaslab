# Disable directory indexing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

# Block direct HTTP access to private directories & sensitive deployment files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(uploads|storage|config|includes)(/.*)?$ - [F,L,NC]
    RewriteRule ^(Dockerfile|docker-compose\.yml|router\.php|\.dockerignore|\.gitignore|\.env.*)$ - [F,L,NC]
    
    # Route manifest.json ke manifest.php dan sw.js ke sw.php untuk kebal dari restriksi hosting InfinityFree
    RewriteRule ^manifest\.json$ manifest.php [L,QSA]
    RewriteRule ^sw\.js$ sw.php [L,QSA]
</IfModule>

# MIME type untuk Manifest PWA & Service Worker
<IfModule mod_mime.c>
    AddType application/manifest+json .json .webmanifest
    AddType application/javascript .js
</IfModule>

# Protect sensitive files & databases (Catatan: file manifest.json tidak diblokir)
<FilesMatch "(?i)^(Dockerfile|docker-compose\.yml|router\.php|composer\.json|package\.json|\.dockerignore|\.gitignore|\.env.*)$|\.(sql|sqlite|db|env|ini|log|sh|bak|swp|md|lock|git.*|yml|yaml|example|config)$">
    Order Deny,Allow
    Deny from all
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Allow public SEO & PWA files: manifest.json, manifest.php, robots.txt, sitemap.xml, sw.js, sw.php, offline.html
<FilesMatch "^(manifest\.(json|php)|robots\.txt|sitemap\.xml|sw\.(js|php)|offline\.html)$">
    Order Allow,Deny
    Allow from all
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
