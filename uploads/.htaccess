# Disable script execution in uploads directory (Anti-RCE)
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|inc|cgi|pl|py|sh|bash|exe|asp|aspx|jsp)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Turn off PHP engine if mod_php is active
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent mime-type spoofing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Disable directory indexing
Options -Indexes -ExecCGI

